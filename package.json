{
  "name": "codex-relay-router",
  "version": "0.2.33",
  "description": "本地优先的 Responses API 智能路由网关与桌面管理工具",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n gateway,ui -c green,cyan \"npm:dev:server\" \"npm:dev:ui\"",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:prepare": "node scripts/prepare-desktop-runtime.mjs",
    "dev:server": "node --no-warnings server/index.mjs",
    "dev:ui": "vite --host 0.0.0.0 --port 5176 --strictPort",
    "build": "npm run check:version && tsc --noEmit && vite build",
    "check:version": "node scripts/check-version.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.542.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.0",
    "vite": "^7.3.0"
  }
}
