{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "咪咪 Router",
  "version": "0.2.32",
  "identifier": "com.chen.codex-router",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5176",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run desktop:prepare && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "咪咪 Router",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:18080"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../server/": "server/",
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNTI5OUUzQkY0NkJCNjYKUldSbXUwYS80NWxTY2dTZDY4OUdHdzkzRXdwa0doLzRreVRDMDRXUnlPUzJ4Wkp1SjAvMFJnOEsK",
      "endpoints": [
        "https://github.com/794308525/mimi-router/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
